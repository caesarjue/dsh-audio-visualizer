{
  "name": "dsh-audio-visualizer",
  "version": "1.0.0",
  "description": "System-audio driven UI visualizer for DeepSeek Harness: a draggable 48-band spectrum chip plus a frame-wide bass glow (memory-only FFT).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "patch/",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "audio",
    "visualizer",
    "spectrum",
    "loopback"
  ],
  "author": "caesarjue",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caesarjue/dsh-audio-visualizer.git"
  },
  "homepage": "https://github.com/caesarjue/dsh-audio-visualizer#readme",
  "bugs": {
    "url": "https://github.com/caesarjue/dsh-audio-visualizer/issues"
  }
}
