+//#region dsh-audio-visualizer patch (local, 2026-09-12)
+// Grants every renderer session the system-output loopback audio for
+// getDisplayMedia() (Core Audio taps / "Catap" pick-up), so the audio-visualizer
+// plugin can run its AnalyserNode on the system mix. Audio stays in-process.
+// NOTE: the main UI lives in a dedicated partition ("dsh-desktop-renderer"),
+// so the handler must be installed per-webContents session, not just default.
+if (process.platform === "darwin") {
+	app.commandLine.appendSwitch("enable-features", "MacCatapLoopbackAudioForScreenShare");
+	const installLoopback = (targetSession) => {
+		try {
+			targetSession.setDisplayMediaRequestHandler((_request, callback) => {
+				// All failure paths must be swallowed: this app runs a fail-loud
+				// handler that turns unhandled rejections into a fatal exit.
+				const safeCallback = (payload) => {
+					try {
+						callback(payload);
+					} catch {}
+				};
+				desktopCapturer.getSources({ types: ["screen"] }).then(
+					(sources) => {
+						if (sources && sources.length > 0) {
+							safeCallback({ video: sources[0], audio: "loopback" });
+						} else {
+							safeCallback({ audio: "loopback" });
+						}
+					},
+					() => {
+						safeCallback({ audio: "loopback" });
+					}
+				);
+			}, { useSystemPicker: false });
+		} catch {}
+	};
+	void app.whenReady().then(() => {
+		installLoopback(session.defaultSession);
+	});
+	app.on("web-contents-created", (_event, contents) => {
+		try {
+			installLoopback(contents.session);
+		} catch {}
+	});
+}
